{
  "worker_processes": 1,
  "dashboard": { "enabled": false },
  "rate_limit": { "max_per_minute": 5, "backoff_base_seconds": 10, "backoff_max_seconds": 60 },
  "blacklist": ["127.0.0.9", { "ip": "127.0.0.8", "until": "2035-01-01T00:00:00" }],
  "heartbeat": { "enabled": true, "interval_seconds": 5 },
  "routes": [
    {
      "name": "payments",
      "listen_port": 9000,
      "backends": [
        { "host": "127.0.0.1", "port": 7001 }
      ]
    },
    {
      "name": "orders",
      "listen_port": 9003,
      "backends": [
        { "host": "127.0.0.1", "port": 7003, "whitelist": ["127.0.0.5"] },
        { "host": "127.0.0.1", "port": 7004, "blacklist": ["127.0.0.5"], "rate_limit": { "max_per_minute": 3 } },
        { "host": "127.0.0.1", "port": 7005, "disabled": true }
      ]
    }
  ]
}
