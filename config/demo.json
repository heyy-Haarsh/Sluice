        },
        {
          "heartbeat": true,
          "host": "127.0.0.1",
          "port": 8002,
          "proxy_protocol": true
        },
        {
          "heartbeat": true,
          "host": "127.0.0.1",
          "port": 8003,
          "proxy_protocol": true
        },
        {
          "heartbeat": true,
          "host": "127.0.0.1",
          "port": 8004,
